# Copy to .env and fill in. .env is gitignored — never commit real tokens.
# Get these from Telegram's @BotFather (token) and @userinfobot (chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Adzuna aggregator API (optional, free tier). Register a free app at
# https://developer.adzuna.com/ to get these. Unlike the scraped boards,
# Adzuna works from the cloud/datacenter IPs. Leave blank to skip Adzuna.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
