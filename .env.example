# Copy to .env and fill in. .env is gitignored — never commit real tokens.
# Get these from Telegram's @BotFather (token) and @userinfobot (chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Adzuna aggregator API (OPTIONAL and PAID — disabled by default). The free
# signup is only a 25-call trial; sustained use is £8/month (500 calls/day).
# Unlike the scraped boards, Adzuna works from the cloud/datacenter IPs, so it
# only matters for a cloud deploy. Leave blank to skip (the repo stays free).
# To use it: register + subscribe at https://developer.adzuna.com/, fill these,
# and set adzuna.enabled: true in the profile.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
